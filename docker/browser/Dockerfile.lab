# Additional test tooling only; same pinned image/packages as M12.1.
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools=2:3.98-1ubuntu0.2 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /opt/browser/requirements.txt
RUN pip install --no-cache-dir --no-deps -r /opt/browser/requirements.txt && pip check
COPY *.py /opt/browser/
USER pwuser
ENV HOME=/tmp/browser-home PYTHONUNBUFFERED=1
WORKDIR /tmp
ENTRYPOINT ["python", "/opt/browser/lab_probe.py"]
